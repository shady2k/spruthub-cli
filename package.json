{
  "name": "spruthub-cli",
  "version": "1.0.5",
  "description": "CLI tool for managing Spruthub smart home devices",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "spruthub-cli": "dist/bin/spruthub-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/spruthub-cli.ts",
    "start": "node bin/spruthub-cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "keywords": [
    "spruthub",
    "smart-home",
    "cli",
    "iot",
    "home-automation",
    "websocket",
    "json-rpc"
  ],
  "author": "shady2k <shady2k@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "11.1.0",
    "inquirer": "9.3.8",
    "js-yaml": "4.3.2",
    "keytar": "7.9.0",
    "ora": "7.0.1",
    "spruthub-client": "1.2.15"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/inquirer": "9.0.10",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "memfs": "4.80.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shady2k/spruthub-cli.git"
  },
  "bugs": {
    "url": "https://github.com/shady2k/spruthub-cli/issues"
  },
  "homepage": "https://github.com/shady2k/spruthub-cli#readme",
  "preferGlobal": true
}
